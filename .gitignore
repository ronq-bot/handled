# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
/.data
/.data

# iCloud conflict copies. This project sits under a Desktop that iCloud
# syncs, and iCloud resolves a conflict by leaving "name 2.ts" beside
# "name.ts". Two of those reached main before this rule existed — stale
# snapshots of a live file, which is the worst kind of thing to leave in
# a repo for someone to read. Ignored rather than tidied by hand,
# because they come back.
* [0-9].*
